import React, { useState } from 'react';
import { StyleSheet, Text, View, TextInput, TouchableOpacity, ScrollView, SafeAreaView, KeyboardAvoidingView, Platform } from 'react-native';
import * as Speech from 'expo-speech';

export default function App() {
  const [messages, setMessages] = useState([
    { sender: 'ai', text: 'नमस्ते! मैं आपका अनुभवी और समझदार मार्गदर्शक हूँ। बताइए, आज मैं आपकी क्या सहायता कर सकता हूँ?' }
  ]);
  const [inputText, setInputText] = useState('');

  const sendMessage = async () => {
    if (!inputText.trim()) return;

    const userMessage = inputText;
    setMessages(prev => [...prev, { sender: 'user', text: userMessage }]);
    setInputText('');

    try {
      const aiResponse = "मैंने आपकी बात को गहराई से समझ लिया है। हर समस्या का समाधान धैर्य और सही सूझबूझ से ही निकलता है।";
      setMessages(prev => [...prev, { sender: 'ai', text: aiResponse }]);
      Speech.speak(aiResponse, { language: 'hi-IN', pitch: 1.0, rate: 0.9 });
    } catch (error) {
      const errorMsg = 'क्षमा करें, अभी सर्वर से संपर्क नहीं हो पा रहा है।';
      setMessages(prev => [...prev, { sender: 'ai', text: errorMsg }]);
      Speech.speak(errorMsg, { language: 'hi-IN' });
    }
  };

  return (
    <SafeAreaView style={styles.container}>
      <KeyboardAvoidingView behavior={Platform.OS === 'ios' ? 'padding' : 'height'} style={styles.container}>
        <View style={styles.header}>
          <Text style={styles.headerText}>अनुभव (Anubhav AI)</Text>
          <Text style={styles.subHeaderText}>आपका मार्गदर्शक</Text>
        </View>
        
        <ScrollView style={styles.chatContainer}>
          {messages.map((msg, index) => (
            <View key={index} style={[styles.bubble, msg.sender === 'user' ? styles.userBubble : styles.aiBubble]}>
              <Text style={styles.messageText}>{msg.text}</Text>
            </View>
          ))}
        </ScrollView>

        <View style={styles.inputContainer}>
          <TextInput
            style={styles.input}
            placeholder="यहाँ हिंदी में लिखें या पूछें..."
            placeholderTextColor="#888"
            value={inputText}
            onChangeText={setInputText}
          />
          <TouchableOpacity style={styles.sendButton} onPress={sendMessage}>
            <Text style={styles.sendButtonText}>भेजें</Text>
          </TouchableOpacity>
        </View>
      </KeyboardAvoidingView>
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: '#f5f5f5' },
  header: { backgroundColor: '#3b5249', padding: 16, alignItems: 'center', borderBottomWidth: 2, borderBottomColor: '#a3b18b' },
  headerText: { color: '#fff', fontSize: 20, fontWeight: 'bold' },
  subHeaderText: { color: '#d8f3dc', fontSize: 12, marginTop: 2 },
  chatContainer: { flex: 1, padding: 15 },
  bubble: { padding: 12, borderRadius: 10, marginVertical: 6, maxWidth: '85%' },
  userBubble: { backgroundColor: '#d8f3dc', alignSelf: 'flex-end', borderBottomRightRadius: 0 },
  aiBubble: { backgroundColor: '#fff', alignSelf: 'flex-start', borderWidth: 1, borderColor: '#d4c5b9', borderBottomLeftRadius: 0 },
  messageText: { fontSize: 16, color: '#2c2c2c', lineHeight: 22 },
  inputContainer: { flexDirection: 'row', padding: 10, backgroundColor: '#fff', borderTopWidth: 1, borderTopColor: '#e0e0e0' },
  input: { flex: 1, borderWidth: 1, borderColor: '#ccc', borderRadius: 25, paddingHorizontal: 15, height: 45, fontSize: 16, backgroundColor: '#fafafa' },
  sendButton: { backgroundColor: '#3b5249', justifyContent: 'center', alignItems: 'center', borderRadius: 25, paddingHorizontal: 20, marginLeft: 10 },
  sendButtonText: { color: '#fff', fontWeight: 'bold', fontSize: 15 }
});
